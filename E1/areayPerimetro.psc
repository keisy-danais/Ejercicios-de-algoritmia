Algoritmo areayPerimetro
	
	Definir area, base, altura, perimetro Como Real
	
	Escribir "Digite la base del resctangulo"
	Leer base
	
	Escribir "Digite la altura "
	Leer altura
	
	area=base*altura
	perimetro=2*(base+altura)
	
	Escribir "su resultado de area es: ",area
	Escribir "Su resultado del perimetro es: ",perimetro
	
FinAlgoritmo
